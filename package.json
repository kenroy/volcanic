{
  "name": "volcanic",
  "version": "0.2.1",
  "description": "A visual, accessible editor for Mermaid diagrams in Obsidian, rendered by Pele.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node --test",
    "harness": "node esbuild.config.mjs harness && node dev/serve.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "mermaid",
    "pele",
    "diagram"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "date-holidays": "^3.39.1",
    "pele": "^1.13.0"
  },
  "author": "kenroy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenroy/volcanic.git"
  },
  "bugs": {
    "url": "https://github.com/kenroy/volcanic/issues"
  },
  "homepage": "https://github.com/kenroy/volcanic#readme"
}
